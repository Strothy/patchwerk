{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Patchwerk",
  "version": "0.1.0",
  "identifier": "com.strothy.patchwerk",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5183",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Patchwerk",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "minWidth": 960,
        "minHeight": 600,
        "visible": false,
        "backgroundColor": "#0a0e0d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost ws: http://localhost:5183; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "license": "GPL-3.0-only",
    "windows": { "minimumWebview2Version": "120.0.0.0", "nsis": { "installMode": "currentUser", "displayLanguageSelector": false } },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
